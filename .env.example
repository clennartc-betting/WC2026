# Kopieer dit bestand naar `.env` voor lokale uitvoering.
# `.env` wordt NIET gecommit (zie .gitignore).
# In GitHub Actions worden deze waarden uit repository Secrets gelezen.

# Verplicht: jouw The Odds API sleutel (https://the-odds-api.com)
ODDS_API_KEY=jouw_odds_api_key_hier

# Optioneel: alleen nodig als je vanaf lokaal GitHub Issues wilt aanmaken.
# In Actions wordt GH_TOKEN automatisch ingevuld via GITHUB_TOKEN secret.
# Lokaal: maak een Personal Access Token aan met `repo` + `issues` scopes.
GH_TOKEN=
GH_REPO=jouw-username/wk2026-bot

# Optioneel: overschrijf defaults
# WK2026_DB=wk2026.db
# WK2026_SPORT=soccer_fifa_world_cup
# WK2026_REGIO=eu,uk
# WK2026_STARTBANKROLL=100
# WK2026_THRESHOLD=0.06
# WK2026_THRESHOLD_REBET=0.12
# WK2026_VROEG_UUR=48
# WK2026_LAAT_UUR=6
# WK2026_KELLY_FRACTIE=0.25
# WK2026_MAX_BET_FRACTIE=0.05
