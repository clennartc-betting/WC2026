# Kopieer dit bestand naar `.env` voor lokale uitvoering.
# `.env` wordt NIET gecommit (zie .gitignore).
# In GitHub Actions worden deze waarden uit repository Secrets gelezen.

# Verplicht: jouw The Odds API sleutel (https://the-odds-api.com)
ODDS_API_KEY=jouw_odds_api_key_hier

# Optioneel: alleen nodig als je vanaf lokaal GitHub Issues wilt aanmaken.
# In Actions wordt GH_TOKEN automatisch ingevuld via GITHUB_TOKEN secret.
# Lokaal: maak een Personal Access Token aan met `repo` + `issues` scopes.
GH_TOKEN=
GH_REPO=jouw-username/wk2026-bot

# ── Pre-match notificaties: WhatsApp via CallMeBot ──────────────────────────
# Setup (eenmalig, ~2 min):
#   1. Sla +34 611 04 87 48 op als contact (CallMeBot).
#   2. Stuur die contact via WhatsApp exact: "I allow callmebot to send me messages"
#   3. Je krijgt binnen ~2 min een persoonlijke apikey terug. Vul die hieronder in.
# CALLMEBOT_PHONE bevat je eigen nummer met landcode (bv. +31612345678).
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Optionele e-mail fallback (gebruikt als CallMeBot niet is ingesteld).
# Maak een Gmail "app password" aan (niet je gewone wachtwoord).
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=clennartc@gmail.com

# Test je kanaal zonder echt te versturen:  WK2026_NOTIFY_DRYRUN=1
# WK2026_NOTIFY_DRYRUN=

# ── Optioneel: overschrijf defaults ─────────────────────────────────────────
